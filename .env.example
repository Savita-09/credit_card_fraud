# FastAPI configuration. Relative paths resolve from the project root.
FRAUD_MODEL_DIR=models
FRAUD_HISTORY_DB=data/prediction_history.db
FRAUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRAUD_MAX_UPLOAD_BYTES=5242880
FRAUD_MAX_BATCH_ROWS=10000
FRAUD_RISK_MEDIUM=0.30
FRAUD_RISK_HIGH=0.70
# Omit/leave empty to use the exact validation-selected threshold.
FRAUD_DEFAULT_THRESHOLD=
# Used as a Compose build argument. Local Vite reads frontend/.env.local.
VITE_API_BASE_URL=/api
# No credentials required for the local benchmark.
